---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PhotoTile from '../components/PhotoTile.astro';
import { BUSINESS, ROOMS } from '../lib/site';
---
<BaseLayout title="Las salas" description="Descubre la sala principal, la zona de juegos, la merienda y la zona de familias de Funny Kids.">
  <section class="pb-10 pt-12 sm:pt-16">
    <div class="wrap">
      <span class="eyebrow">
        <Icon name="sparkles" class="h-4 w-4 text-coral" />
        El espacio
      </span>
      <h1 class="mt-5 max-w-3xl text-5xl leading-[1.02] sm:text-6xl">
        Cinco rincones, una sola fiesta
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Más de 200 m² pensados para que los peques jueguen sin parar y los adultos estén cómodos.
        Cada reserva es en exclusiva: la sala es solo para vosotros.
      </p>

      <div class="mt-8 flex flex-wrap gap-2">
        <span class="chip"><Icon name="users" class="h-4 w-4" /> Hasta {BUSINESS.capacity} niños</span>
        <span class="chip"><Icon name="lock" class="h-4 w-4" /> Sala privada</span>
        <span class="chip"><Icon name="clock" class="h-4 w-4" /> Franjas de 2 o 3 horas</span>
        <span class="chip"><Icon name="shield" class="h-4 w-4" /> Suelo acolchado</span>
      </div>
    </div>
  </section>

  <section class="pb-4">
    <div class="wrap">
      <div class="grid gap-4 sm:grid-cols-3">
        <PhotoTile emoji="🟡" label="Piscina de bolas" color="mint" class="h-56 sm:h-64 sm:col-span-2" />
        <PhotoTile emoji="⚽" label="Futbolín" color="sun" class="h-56 sm:h-64" />
      </div>
    </div>
  </section>

  <div class="wrap divide-y-2 divide-ink/10">
    {ROOMS.map((room, i) => (
      <section class="grid items-center gap-8 py-12 lg:grid-cols-2 lg:gap-14">
        <div class:list={[i % 2 === 1 ? 'lg:order-2' : '']}>
          <p class="font-display text-sm font-bold uppercase tracking-[0.16em] text-coral">{room.kicker}</p>
          <h2 class="mt-3 text-4xl sm:text-5xl">{room.name}</h2>
          <p class="mt-4 text-lg leading-relaxed text-ink-soft">{room.text}</p>

          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {room.bullets.map((b) => (
              <li class="flex items-start gap-2 text-sm text-ink-soft">
                <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-coral" />
                {b}
              </li>
            ))}
          </ul>
        </div>

        <div class:list={[i % 2 === 1 ? 'lg:order-1' : '']}>
          <PhotoTile emoji={room.emoji} label={room.name} color={room.color} class="h-64 sm:h-80" />
        </div>
      </section>
    ))}
  </div>

  <section class="pt-12">
    <div class="wrap">
      <div class="rounded-[2.5rem] border-2 border-ink/10 bg-white p-8 sm:p-12">
        <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-center">
          <div>
            <h2 class="text-3xl sm:text-4xl">¿Te lo enseñamos antes de reservar?</h2>
            <p class="mt-3 max-w-xl text-ink-soft">
              Podemos quedar un rato para que veas el espacio con calma, sin compromiso. Escríbenos o llámanos.
            </p>
          </div>
          <div class="flex flex-wrap gap-3">
            <a href="/reservas" class="btn-primary">Ver disponibilidad</a>
            <a href={BUSINESS.whatsapp} class="btn-ghost" target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" class="h-4 w-4" />
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

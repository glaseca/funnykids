---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { BUSINESS } from '../../lib/site';
import { PRICING, RULES } from '../../lib/config';
import { formatEUR } from '../../lib/money';

export const prerender = false;

const LEGAL: Record<string, { title: string; intro: string; blocks: Array<{ h: string; p: string[] }> }> = {
  aviso: {
    title: 'Aviso legal',
    intro:
      'Este sitio web pertenece a Funny Kids, espacio de celebraciones infantiles en Getafe. Los datos que aparecen a continuación son de demostración y se sustituirán por los reales antes de la puesta en producción.',
    blocks: [
      {
        h: 'Titular del sitio',
        p: [
          `Denominación: ${BUSINESS.legalName}`,
          `Domicilio: ${BUSINESS.address}`,
          `Teléfono: ${BUSINESS.phone}`,
          `Email: ${BUSINESS.email}`,
        ],
      },
      {
        h: 'Objeto',
        p: [
          'Este sitio tiene como finalidad informar sobre el alquiler de la sala de fiestas infantiles Funny Kids y permitir la reserva online de franjas horarias.',
          'El acceso al sitio es gratuito y no exige registro previo. La reserva de una franja implica la aceptación de las condiciones de reserva publicadas.',
        ],
      },
      {
        h: 'Propiedad intelectual',
        p: [
          'Los textos, ilustraciones, logotipos y demás contenidos de este sitio son titularidad de Funny Kids o se utilizan con licencia. Queda prohibida su reproducción total o parcial sin autorización escrita.',
          'Las fotografías de las instalaciones que se publicarán próximamente sustituirán a las ilustraciones de demostración actuales.',
        ],
      },
      {
        h: 'Responsabilidad',
        p: [
          'Funny Kids no se hace responsable de los daños derivados del uso incorrecto del sitio ni de las interrupciones del servicio por causas técnicas ajenas a su control.',
          'Los enlaces a terceros se facilitan únicamente como referencia y no implican relación comercial alguna.',
        ],
      },
    ],
  },
  privacidad: {
    title: 'Política de privacidad',
    intro:
      'Tratamos tus datos solo para gestionar la reserva, enviarte los correos del cumpleaños y cumplir las obligaciones legales. Nada de publicidad sin permiso.',
    blocks: [
      {
        h: 'Responsable del tratamiento',
        p: [
          `${BUSINESS.legalName} · ${BUSINESS.address} · ${BUSINESS.email}`,
          'Los datos de contacto son de demostración y se sustituirán por los reales antes de la puesta en producción.',
        ],
      },
      {
        h: 'Qué datos recogemos',
        p: [
          'Nombre de la persona que reserva, email, teléfono, nombre y edad del cumpleañero y, si lo indicas, notas sobre alergias o necesidades especiales.',
          'Datos del pago: el importe, la fecha y el identificador de la operación. Los datos de la tarjeta o del Bizum los trata directamente Stripe; Funny Kids no los almacena.',
        ],
      },
      {
        h: 'Para qué los usamos',
        p: [
          'Gestionar la reserva, el pago de la señal y del saldo, y enviarte la confirmación y los recordatorios.',
          'Atender incidencias, cambios de aforo y cancelaciones.',
          'Cumplir con las obligaciones contables y fiscales que nos correspondan.',
        ],
      },
      {
        h: 'Base legal y conservación',
        p: [
          'La base legal es la ejecución del contrato de reserva y, para los recordatorios, tu consentimiento al facilitar el email.',
          'Conservamos los datos mientras la reserva esté activa y, después, durante los plazos legales de conservación contable.',
        ],
      },
      {
        h: 'Destinatarios y derechos',
        p: [
          'Usamos Stripe (pagos) y Resend (envío de emails), ambos proveedores con sede en la UE o con garantías adecuadas. No cedemos datos a terceros para publicidad.',
          'Puedes ejercer tus derechos de acceso, rectificación, supresión, oposición, limitación y portabilidad escribiendo a ' + BUSINESS.email + '. También puedes reclamar ante la Agencia Española de Protección de Datos.',
        ],
      },
    ],
  },
  condiciones: {
    title: 'Condiciones de reserva',
    intro:
      'Queremos que todo quede claro antes de pagar. Estas son las reglas de reserva, pago, cambios y cancelación.',
    blocks: [
      {
        h: 'La franja y el aforo',
        p: [
          `Cada reserva ocupa una franja completa en exclusiva: mañana de 10:30 a 13:30 o tarde de 16:30 a 19:30. Puedes contratar 2 o 3 horas desde la hora de inicio.`,
          `El aforo mínimo es de ${RULES.minChildren} niños y el máximo de ${RULES.maxChildren}. El precio se calcula sobre los niños confirmados, con un mínimo de ${RULES.minChildren}.`,
          'La franja incluye 30 minutos antes del inicio para montar la merienda y decorar. La limpieza final está incluida en el precio; el servicio de limpieza extra es opcional.',
        ],
      },
      {
        h: 'Precio y pago',
        p: [
          `Precio: ${formatEUR(PRICING.perChild2h)} por niño para 2 horas y ${formatEUR(PRICING.perChild3h)} por niño para 3 horas, IVA incluido.`,
          `Limpieza opcional: ${formatEUR(PRICING.cleaning)}. Señal: ${formatEUR(PRICING.deposit)}, que se descuenta del total.`,
          'El resto se puede pagar online con tarjeta o Bizum desde la página de la reserva, o en el local el día del evento. La reserva queda confirmada cuando se recibe la señal.',
        ],
      },
      {
        h: 'Cambios de aforo',
        p: [
          `Puedes cambiar el número de niños hasta ${RULES.headcountCutoffDays} días antes del evento desde la página de gestión de tu reserva. El precio se recalcula automáticamente.`,
          'Si el nuevo aforo es menor, el saldo pendiente se ajusta. Si ya habías pagado de más, lo descontamos del saldo o lo devolvemos por el mismo medio.',
        ],
      },
      {
        h: 'Cancelación y devolución',
        p: [
          `Si cancelas con al menos ${RULES.freeCancellationDays} días de antelación, te devolvemos la señal íntegra.`,
          `Si cancelas con menos de ${RULES.freeCancellationDays} días, la señal no es reembolsable porque la franja ya está bloqueada y es difícil de recolocar.`,
          'También puedes cambiar la fecha sin coste hasta 7 días antes, sujeto a disponibilidad, escribiéndonos por WhatsApp o email.',
        ],
      },
      {
        h: 'Normas del espacio',
        p: [
          'Los niños deben estar acompañados por al menos un adulto responsable. Funny Kids no presta servicio de cuidado ni de animación.',
          'No se permite fumar ni consumir alcohol en el interior. Está prohibido el uso de confeti, pinturas o materiales que manchen las instalaciones sin autorización.',
          'Funny Kids no se hace responsable de los objetos personales olvidados o perdidos durante el evento.',
        ],
      },
    ],
  },
};

const { slug = '' } = Astro.params;
const page = LEGAL[slug];

if (!page) {
  return Astro.redirect('/legal/aviso', 302);
}
---

<BaseLayout title={page.title} description={page.intro} noindex>
  <section class="pb-10 pt-12 sm:pt-16">
    <div class="wrap max-w-3xl">
      <a href="/" class="inline-flex items-center gap-2 text-sm font-semibold text-ink-soft hover:text-ink">
        <Icon name="arrow-left" class="h-4 w-4" />
        Volver al inicio
      </a>
      <h1 class="mt-5 text-4xl leading-tight sm:text-5xl">{page.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft">{page.intro}</p>
      <p class="mt-4 text-xs uppercase tracking-wide text-ink/40">Última actualización: noviembre de 2026 · Versión demo</p>
    </div>
  </section>

  <section class="pb-10">
    <div class="wrap max-w-3xl space-y-4">
      {page.blocks.map((block) => (
        <article class="card p-7 sm:p-9">
          <h2 class="text-2xl">{block.h}</h2>
          <div class="mt-3 space-y-3 text-ink-soft">
            {block.p.map((paragraph) => <p class="leading-relaxed">{paragraph}</p>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="pb-8">
    <div class="wrap max-w-3xl">
      <div class="flex flex-wrap items-center justify-between gap-4 rounded-3xl border-2 border-ink/10 bg-white p-6">
        <p class="text-sm text-ink-soft">
          ¿Te queda alguna duda sobre la reserva?
        </p>
        <div class="flex flex-wrap gap-2">
          <a href="/contacto" class="btn-ghost px-5 py-2.5 text-sm">Contacto</a>
          <a href="/reservas" class="btn-primary px-5 py-2.5 text-sm">Ver disponibilidad</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

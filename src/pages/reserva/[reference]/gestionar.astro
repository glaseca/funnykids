---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getBookingByReference } from '../../../lib/db';
import { RULES, slotLabel } from '../../../lib/config';
import { canChangeHeadcount } from '../../../lib/bookings';
import { diffDays, formatLongYear, todayISO } from '../../../lib/dates';
import { formatEUR, formatEURExact } from '../../../lib/money';
import { stripeEnabled } from '../../../lib/stripe';

export const prerender = false;

const { reference = '' } = Astro.params;
const token = Astro.url.searchParams.get('token') ?? '';
const booking = getBookingByReference(reference);

if (!booking || !token || token !== booking.manage_token) {
  return Astro.redirect(`/reserva/${reference}?error=Enlace de gestión no válido.`, 302);
}

const pending = Math.max(0, booking.subtotal_cents - booking.paid_cents);
const days = diffDays(booking.date, todayISO());
const editable = canChangeHeadcount(booking);
const refundable = days >= RULES.freeCancellationDays;
const ok = Astro.url.searchParams.get('ok');
const error = Astro.url.searchParams.get('error');
const active = booking.status === 'confirmed' || booking.status === 'pending';

const okMessages: Record<string, string> = {
  ninos: 'Hemos actualizado el número de niños y recalculado el importe.',
  cancelada: refundable
    ? 'Reserva cancelada. Te devolveremos la señal por el mismo medio de pago.'
    : 'Reserva cancelada. La señal no es reembolsable porque faltan menos de 7 días.',
};

const statusLabels: Record<string, string> = {
  pending: 'Pendiente de pago',
  confirmed: 'Confirmada',
  completed: 'Celebrada',
  cancelled: 'Cancelada',
  expired: 'Expirada',
};
---

<BaseLayout title={`Gestionar reserva ${booking.reference}`} noindex>
  <section class="pb-10 pt-12 sm:pt-16">
    <div class="wrap max-w-3xl">
      <a href={`/reserva/${booking.reference}`} class="inline-flex items-center gap-2 text-sm font-semibold text-ink-soft hover:text-ink">
        <Icon name="arrow-left" class="h-4 w-4" /> Volver a la reserva
      </a>
      <h1 class="mt-4 text-4xl sm:text-5xl">Gestionar reserva</h1>
      <p class="mt-3 text-lg text-ink-soft">
        {formatLongYear(booking.date)} · {slotLabel(booking.turn, booking.duration)}
      </p>
      <p class="mt-1 text-sm text-ink/45">Referencia {booking.reference} · {booking.customer_name}</p>

      {ok && (
        <div class="mt-6 rounded-2xl border-2 border-mint bg-mint/20 p-4 text-sm font-semibold">
          {okMessages[ok] ?? 'Cambios guardados.'}
        </div>
      )}
      {error && (
        <div class="mt-6 rounded-2xl border-2 border-coral/40 bg-coral/10 p-4 text-sm font-semibold text-coral-dark">
          {error}
        </div>
      )}

      <div class="mt-6 grid gap-5 sm:grid-cols-3">
        <div class="card p-5">
          <p class="text-xs font-bold uppercase tracking-wide text-ink/40">Estado</p>
          <p class="mt-1 font-display text-xl font-extrabold">{statusLabels[booking.status] ?? booking.status}</p>
        </div>
        <div class="card p-5">
          <p class="text-xs font-bold uppercase tracking-wide text-ink/40">Total</p>
          <p class="mt-1 font-display text-xl font-extrabold">{formatEURExact(booking.subtotal_cents)}</p>
        </div>
        <div class="card p-5">
          <p class="text-xs font-bold uppercase tracking-wide text-ink/40">Pendiente</p>
          <p class="mt-1 font-display text-xl font-extrabold">{formatEURExact(pending)}</p>
        </div>
      </div>

      {booking.status === 'cancelled' && (
        <div class="card mt-5 p-6">
          <h2 class="text-xl">Reserva cancelada</h2>
          <p class="mt-2 text-sm text-ink-soft">
            Si quieres buscar otra fecha, el calendario está actualizado en tiempo real.
          </p>
          <a href="/reservas" class="btn-primary mt-4">Ver disponibilidad</a>
        </div>
      )}

      {active && (
        <div class="mt-5 space-y-5">
          <div class="card p-6">
            <h2 class="text-xl">Número de niños</h2>
            <p class="mt-1 text-sm text-ink-soft">
              El precio se recalcula automáticamente. Puedes cambiarlo hasta {RULES.headcountCutoffDays} días antes del evento.
            </p>

            {editable ? (
              <form method="post" action="/api/manage" class="mt-4 flex flex-wrap items-end gap-3">
                <input type="hidden" name="reference" value={booking.reference} />
                <input type="hidden" name="token" value={token} />
                <input type="hidden" name="action" value="update-children" />
                <div>
                  <label for="children" class="label">Niños confirmados</label>
                  <input
                    id="children"
                    name="children"
                    type="number"
                    min={RULES.minChildren}
                    max={RULES.maxChildren}
                    required
                    value={booking.children_final ?? booking.children}
                    class="field w-32 text-center font-display text-lg font-extrabold"
                  />
                </div>
                <button type="submit" class="btn-primary">Guardar cambios</button>
              </form>
            ) : (
              <p class="mt-4 rounded-2xl bg-cream p-4 text-sm text-ink-soft">
                Ya no se puede cambiar online (faltan {days} días). Escríbenos y lo vemos juntos.
              </p>
            )}
          </div>

          {pending > 0 && (
            <div class="card flex flex-wrap items-center justify-between gap-4 p-6">
              <div>
                <h2 class="text-xl">Pagar el saldo</h2>
                <p class="mt-1 text-sm text-ink-soft">
                  {formatEURExact(pending)} pendientes. Puedes pagarlo ahora con tarjeta o Bizum.
                </p>
              </div>
              {stripeEnabled() ? (
                <form method="post" action="/api/pay">
                  <input type="hidden" name="reference" value={booking.reference} />
                  <input type="hidden" name="kind" value="balance" />
                  <button type="submit" class="btn-primary">Pagar {formatEURExact(pending)}</button>
                </form>
              ) : (
                <a href={`/pago-demo/${booking.reference}`} class="btn-primary">Pagar {formatEURExact(pending)} (demo)</a>
              )}
            </div>
          )}

          <div class="card p-6">
            <h2 class="text-xl">Cancelar la reserva</h2>
            <p class="mt-2 text-sm text-ink-soft">
              {refundable
                ? `Cancelando ahora (faltan ${days} días) te devolvemos la señal íntegra: ${formatEUR(booking.paid_cents)}.`
                : `Faltan ${days} días, así que la señal no es reembolsable. Si cancelas, la franja quedará libre para otra familia.`}
            </p>

            <details class="mt-4 rounded-2xl border-2 border-coral/30 bg-coral/5 p-4">
              <summary class="cursor-pointer font-display font-bold text-coral-dark">
                Quiero cancelar la reserva
              </summary>
              <form method="post" action="/api/manage" class="mt-4">
                <input type="hidden" name="reference" value={booking.reference} />
                <input type="hidden" name="token" value={token} />
                <input type="hidden" name="action" value="cancel" />
                <label class="flex items-start gap-3 text-sm text-ink-soft">
                  <input type="checkbox" required class="mt-0.5 h-4 w-4 shrink-0 accent-ink" />
                  <span>Confirmo que quiero cancelar la reserva del {formatLongYear(booking.date)}.</span>
                </label>
                <button type="submit" class="btn-dark mt-4 bg-coral text-white" style="box-shadow:none;">
                  Cancelar definitivamente
                </button>
              </form>
            </details>

            <p class="mt-4 text-xs text-ink/50">
              Si tu caso es un imprevisto, escríbenos antes de cancelar: intentamos recolocar la fecha.
            </p>
          </div>

          <div class="rounded-2xl border-2 border-ink/10 bg-white p-5 text-sm">
            <p class="font-display font-bold">¿Cambiar de fecha o de horario?</p>
            <p class="mt-1 text-ink-soft">
              Los cambios de fecha se gestionan a mano para no perder la señal. Escríbenos y lo movemos si hay hueco.
            </p>
            <a href="/contacto" class="link-underline mt-2 inline-block">Contactar</a>
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PhotoTile from '../components/PhotoTile.astro';
import { BUSINESS, FAQ } from '../lib/site';
---

<BaseLayout title="Contacto" description="Cómo llegar a Funny Kids en Getafe, horarios, teléfono y WhatsApp para resolver cualquier duda.">
  <section class="pb-10 pt-12 sm:pt-16">
    <div class="wrap">
      <span class="eyebrow">
        <Icon name="pin" class="h-4 w-4 text-coral" />
        Estamos en Getafe
      </span>
      <h1 class="mt-5 max-w-3xl text-5xl leading-[1.02] sm:text-6xl">
        Escríbenos, llámanos o pásate a verlo
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-ink-soft">
        Resolvemos dudas por WhatsApp en minutos. Si prefieres ver la sala antes de reservar,
        quedamos un rato contigo sin compromiso.
      </p>
    </div>
  </section>

  <section class="pb-12">
    <div class="wrap grid gap-5 lg:grid-cols-[1.1fr_0.9fr]">
      <div class="card p-7 sm:p-9">
        <h2 class="text-2xl">Datos de contacto</h2>
        <ul class="mt-6 space-y-5">
          <li class="flex gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-mint">
              <Icon name="pin" class="h-5 w-5" />
            </span>
            <div>
              <p class="font-display font-bold">Dirección</p>
              <p class="text-sm text-ink-soft">{BUSINESS.address}</p>
              <a href={BUSINESS.mapsUrl} target="_blank" rel="noopener noreferrer" class="link-underline mt-1 inline-block text-sm">
                Abrir en Google Maps
              </a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-sun">
              <Icon name="phone" class="h-5 w-5" />
            </span>
            <div>
              <p class="font-display font-bold">Teléfono</p>
              <a href={BUSINESS.phoneHref} class="text-sm text-ink-soft hover:text-ink">{BUSINESS.phone}</a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-coral text-white">
              <Icon name="mail" class="h-5 w-5" />
            </span>
            <div>
              <p class="font-display font-bold">Email</p>
              <a href={`mailto:${BUSINESS.email}`} class="text-sm text-ink-soft hover:text-ink">{BUSINESS.email}</a>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-lilac">
              <Icon name="whatsapp" class="h-5 w-5" />
            </span>
            <div>
              <p class="font-display font-bold">WhatsApp</p>
              <a href={BUSINESS.whatsapp} target="_blank" rel="noopener noreferrer" class="text-sm text-ink-soft hover:text-ink">
                Escribir ahora
              </a>
            </div>
          </li>
        </ul>

        <div class="mt-8 rounded-2xl bg-cream p-5">
          <p class="font-display font-bold">Horario de atención</p>
          <ul class="mt-3 space-y-2 text-sm text-ink-soft">
            {BUSINESS.hours.map((h) => (
              <li class="flex flex-wrap justify-between gap-2">
                <span>{h.days}</span>
                <span class="font-semibold text-ink">{h.time}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="flex flex-col gap-5">
        <PhotoTile emoji="🗺️" label="Getafe, Madrid" color="sky" class="h-56" hideLabel={false} />
        <div class="card flex flex-1 flex-col justify-between gap-6 bg-ink p-7 text-cream sm:p-9">
          <div>
            <h2 class="text-2xl text-cream">¿Quieres reservar ya?</h2>
            <p class="mt-3 text-sm leading-relaxed text-cream/70">
              Consulta el calendario en tiempo real, elige franja y deja la fecha bloqueada con 50 €.
              Son dos minutos.
            </p>
          </div>
          <a href="/reservas" class="btn-primary w-full">
            Ver disponibilidad
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-12">
    <div class="wrap">
      <div class="rounded-[2.5rem] border-2 border-ink/10 bg-white p-7 sm:p-10">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
          <div>
            <h2 class="text-3xl sm:text-4xl">Cómo llegar</h2>
            <p class="mt-4 text-ink-soft">
              Estamos en el centro de Getafe, a cinco minutos andando de la estación de Cercanías
              y con aparcamiento en la misma calle. Si vienes en coche, hay zona azul en las
              calles paralelas.
            </p>
            <ul class="mt-6 space-y-3 text-sm text-ink-soft">
              <li class="flex gap-2"><Icon name="check" class="h-4 w-4 text-coral" /> Cercanías C4 y C3 · Getafe Centro</li>
              <li class="flex gap-2"><Icon name="check" class="h-4 w-4 text-coral" /> Autobuses 441, 442 y 448</li>
              <li class="flex gap-2"><Icon name="check" class="h-4 w-4 text-coral" /> Aparcamiento público a 200 m</li>
              <li class="flex gap-2"><Icon name="check" class="h-4 w-4 text-coral" /> Acceso adaptado sin escalones</li>
            </ul>
          </div>
          <div class="overflow-hidden rounded-3xl border-2 border-ink/10 bg-cream">
            <div class="flex h-full min-h-[18rem] flex-col items-center justify-center gap-3 p-8 text-center">
              <span class="text-6xl" aria-hidden="true">📍</span>
              <p class="font-display text-xl font-extrabold">Calle de la Alegría, 24</p>
              <p class="text-sm text-ink-soft">28901 Getafe, Madrid</p>
              <a href={BUSINESS.mapsUrl} target="_blank" rel="noopener noreferrer" class="btn-ghost mt-2">
                Abrir mapa
                <Icon name="arrow-right" class="h-4 w-4" />
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="pb-8">
    <div class="wrap grid gap-5 md:grid-cols-2">
      {FAQ.slice(0, 4).map((item) => (
        <div class="card p-6">
          <h3 class="text-lg">{item.q}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-soft">{item.a}</p>
        </div>
      ))}
    </div>
    <div class="wrap mt-6 text-center text-sm text-ink/45">
      <p>¿No encuentras tu duda? <a href={`mailto:${BUSINESS.email}`} class="link-underline">Escríbenos</a> y te contestamos hoy.</p>
    </div>
  </section>
</BaseLayout>

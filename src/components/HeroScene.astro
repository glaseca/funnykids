  { x: 392, y: 458, r: 31, c: '#FFF7EC' },
  { x: 452, y: 446, r: 26, c: '#FFC94A' },
  { x: 512, y: 456, r: 28, c: '#FF6B5A' },
  { x: 120, y: 396, r: 25, c: '#7FE6C4' },
  { x: 182, y: 402, r: 29, c: '#C3B0FF' },
  { x: 248, y: 392, r: 24, c: '#FF6B5A' },

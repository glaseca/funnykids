---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { BUSINESS, NAV } from '../lib/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="sticky top-0 z-50 border-b-2 border-ink/10 bg-cream/85 backdrop-blur-md">
  <div class="wrap flex h-20 items-center justify-between gap-4">
    <a href="/" aria-label={`${BUSINESS.name}, inicio`} class="rounded-2xl">
      <Logo />
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Principal">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-full px-4 py-2 font-display text-base font-bold transition',
            isActive(item.href) ? 'bg-white text-ink shadow-sm' : 'text-ink/60 hover:bg-white/70 hover:text-ink',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a href={BUSINESS.phoneHref} class="hidden items-center gap-2 rounded-full px-3 py-2 font-display font-bold text-ink/70 hover:text-ink md:inline-flex">
        <Icon name="phone" class="h-4 w-4" />
        <span class="hidden xl:inline">{BUSINESS.phone}</span>
      </a>
      <a href="/reservas" class="btn-primary px-5 py-2.5 text-sm sm:text-base">
        Reservar
        <Icon name="arrow-right" class="h-4 w-4" />
      </a>
      <button
        id="fk-menu-btn"
        type="button"
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border-2 border-ink/15 bg-white text-ink lg:hidden"
        aria-controls="fk-mobile-menu"
        aria-expanded="false"
        aria-label="Abrir menú"
      >
        <Icon name="menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div id="fk-mobile-menu" class="hidden border-t-2 border-ink/10 bg-cream px-5 pb-6 pt-2 lg:hidden">
    <nav class="flex flex-col" aria-label="Menú móvil">
      {NAV.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-2xl px-4 py-3 font-display text-lg font-bold',
            isActive(item.href) ? 'bg-white text-ink' : 'text-ink/70',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a href={BUSINESS.phoneHref} class="mt-2 flex items-center gap-2 rounded-2xl px-4 py-3 font-display font-bold text-ink/70">
        <Icon name="phone" class="h-4 w-4" /> {BUSINESS.phone}
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('fk-menu-btn');
  const menu = document.getElementById('fk-mobile-menu');

  btn?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(isOpen));
    btn.setAttribute('aria-label', isOpen ? 'Cerrar menú' : 'Abrir menú');
  });
</script>

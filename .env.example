# ---------------------------------------------------------------------------
# Funny Kids — variables de entorno
# Copia este archivo a `.env` y rellena lo que necesites.
# Si dejas Stripe vacío, la app funciona en MODO DEMO con un pago simulado.
# ---------------------------------------------------------------------------

# URL pública del sitio (se usa en las redirects de Stripe y en los emails)
SITE_URL=http://localhost:4321

# --- Stripe -----------------------------------------------------------------
# Sin claves => modo demo (pago simulado, no se mueve dinero).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email (Resend) ---------------------------------------------------------
# Sin clave => los emails se guardan en la base de datos y se ven en /admin.
RESEND_API_KEY=
EMAIL_FROM="Funny Kids <reservas@funnykids.es>"
ADMIN_EMAIL=hola@funnykids.es

# --- Admin ------------------------------------------------------------------
ADMIN_PASSWORD=demo1234
AUTH_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# --- Base de datos ----------------------------------------------------------
# Ruta del fichero SQLite. Por defecto: ./data/funnykids.db
# DB_PATH=./data/funnykids.db

# --- Recordatorios ----------------------------------------------------------
# Secreto para llamar a /api/cron/reminders desde un cron externo.
CRON_SECRET=
